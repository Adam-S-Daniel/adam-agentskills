{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"${CLAUDE_PLUGIN_ROOT}/hooks/fleet-guidance/on-session-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
